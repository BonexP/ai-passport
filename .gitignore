build/
sdkconfig
sdkconfig.old
managed_components/
.vscode/
.idea/

# Per-machine compile-time configuration: Wi-Fi presets (with locations) and the
# quote watchlist. The entry must exist before the file is ever created: once a
# path is in the index, `git ls-files --cached` keeps scanning it and a later
# ignore rule cannot undo that.
/main/app_config.local.h

# Legacy preset path. Kept ignored so a leftover file from before the app_config
# migration can never be committed by accident.
/main/wifi_presets.local.h

# Local agent workspace data (session memory, scratch plans). Never part of the
# repository, and never scanned by tools/check_repo.py.
.workbuddy/
.codebuddy/

# Generated repository-local links; canonical skill sources live in skills/.
/.agents/skills/passport-develop
/.agents/skills/passport-setup
/.agents/skills/passport-build
/.agents/skills/passport-device-test
/.agents/skills/passport-debug

# Firmware images built locally or downloaded from CI artifacts.
# The name is misleadingly similar to build/ output, so pin it explicitly.
/FoloToy-AI-Passport*.bin
